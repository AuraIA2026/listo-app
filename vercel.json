{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/azulWebHook",
      "destination": "https://us-central1-listoapp-52b46.cloudfunctions.net/azulWebHook"
    },
    {
      "source": "/merchant",
      "destination": "/merchant.html"
    },
    {
      "source": "/merchant.html",
      "destination": "/merchant.html"
    },
    {
      "source": "/((?!assets/|merchant|merchant.html|style.css|app.js|merchant.js|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
