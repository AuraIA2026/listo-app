rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función global: Verifica que el usuario haya iniciado sesión
    function isAuth() {
      return request.auth != null;
    }

    // Función global: Verifica que el usuario sea administrador
    function isAdmin() {
      return isAuth() && (
        request.auth.token.email == 'listopatron.app@gmail.com' ||
        request.auth.token.email == 'artemediosrd@gmail.com' ||
        request.auth.uid == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. USUARIOS (users)
    match /users/{userId} {
      // Público puede buscar perfiles (para que clientes vean a los profesionales)
      allow read: if true;  
      // Solo el propietario, el mapeo de su propio UID, o el administrador pueden editar los datos
      allow write: if isAuth() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (request.resource.data.uid == request.auth.uid)
      ); 
      
      // Colecciones anidadas (como historiales)
      match /{subcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. CHATS PRIVADOS (chats)
    match /chats/{chatId} {
      // Un usuario puede ver el chat solo si su UID está dentro del arreglo "members" y borrar chats si los tiene
      allow read, update, delete: if isAuth() && (request.auth.uid in resource.data.members || isAdmin());
      // Cualquier usuario autenticado puede crear un chat nuevo
      allow create: if isAuth();

      // MENSAGES DEL CHAT (subcolección)
      match /messages/{messageId} {
        // Lee/escribe mensajes solo si es miembro del chat padre
        allow read, write: if isAuth() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members || isAdmin()
        );
      }
    }

    // 3. PEDIDOS / ÓRDENES (orders)
    match /orders/{orderId} {
      // Clientes, comandera de cocina del restaurante y repartidores pueden leer, crear y actualizar pedidos en vivo
      allow read, create, update: if true;
      allow delete: if isAdmin(); 
    }

    // 4. LOCALES DE PROFESIONALES Y RESTAURANTES (locales)
    match /locales/{localId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || (isAuth() && request.auth.uid == resource.data.proId);
    }

    // 4b. PRODUCTOS Y PLATILLOS (productos)
    match /productos/{prodId} {
      allow read, create, update, delete: if true;
    }

    // 5. NOTIFICACIONES (notificaciones)
    match /notificaciones/{notifId} {
      allow read, create, update, delete: if true;
    }

    // 6. PAGOS (payments)
    match /payments/{paymentId} {
      allow create: if true; // Permitir que la web pública registre intenciones de pago/transferencias
      allow read, update, delete: if isAuth(); // Solo usuarios autenticados en la app pueden ver/validar pagos
    }

    // 6b. COMPRAS DE PLANES (plan_purchases)
    match /plan_purchases/{purchaseId} {
      allow create: if true; // Permitir que la web pública registre compras
      allow read, update, delete: if isAuth();
    }

    // 6c. SOLICITUDES DE EDICION DE PERFIL (profile_edit_requests)
    match /profile_edit_requests/{requestId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth();
    }

    // 6e. HISTORIAS DE TRABAJO (historias)
    match /historias/{storyId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 6f. QUEJAS Y REPORTES (reports)
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth();
    }

    // 6g. SOLICITUDES DE COMERCIOS PARTNER (partner_requests)
    match /partner_requests/{requestId} {
      allow create: if true; // Permitir que la web pública envíe solicitudes de comercio
      allow read, update, delete: if true; // Administrador y app pueden validar y activar comercios
    }

    // 6h. DELIVERYS EN LÍNEA (ubicación en vivo) — el comercio los ve en el mapa
    match /drivers_online/{driverId} {
      allow read: if true;
      allow write: if isAuth() && (request.auth.uid == driverId || isAdmin());
    }

    // 6i. SOLICITUDES DE DELIVERY (comercio -> delivery)
    match /delivery_requests/{reqId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 7. OTRAS COLECCIONES PUBLICAS TEMPORALES (comisiones, etc)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
