rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función global: Verifica que el usuario haya iniciado sesión
    function isAuth() {
      return request.auth != null;
    }

    // Función global: Verifica que el usuario sea administrador
    function isAdmin() {
      return isAuth() && (
        request.auth.token.email == 'listopatron.app@gmail.com' ||
        request.auth.token.email == 'artemediosrd@gmail.com' ||
        request.auth.uid == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. USUARIOS (users)
    match /users/{userId} {
      // Público puede buscar perfiles (para que clientes vean a los profesionales)
      allow read: if true;  
      // Solo el propietario o el administrador pueden editar los datos
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin()); 
      
      // Colecciones anidadas (como historiales)
      match /{subcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. CHATS PRIVADOS (chats)
    match /chats/{chatId} {
      // Un usuario puede ver el chat solo si su UID está dentro del arreglo "members" y borrar chats si los tiene
      allow read, update, delete: if isAuth() && (request.auth.uid in resource.data.members || isAdmin());
      // Cualquier usuario autenticado puede crear un chat nuevo
      allow create: if isAuth();

      // MENSAGES DEL CHAT (subcolección)
      match /messages/{messageId} {
        // Lee/escribe mensajes solo si es miembro del chat padre
        allow read, write: if isAuth() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members || isAdmin()
        );
      }
    }

    // 3. PEDIDOS / ÓRDENES (orders)
    match /orders/{orderId} {
      // Solo el cliente, profesional asignado o administrador pueden ver o editar el pedido
      allow read, update: if isAuth() && (
        request.auth.uid == resource.data.clientId || 
        request.auth.uid == resource.data.proId ||
        isAdmin()
      );
      // Cualquier cliente autenticado puede crear un pedido
      allow create: if isAuth();
      // Eliminar pedidos lo limitamos preferiblemente
      allow delete: if false; 
    }

    // 4. LOCALES DE PROFESIONALES (locales)
    match /locales/{localId} {
      // Todo el mundo puede ver la lista de locales
      allow read: if isAuth();
      // Solo el dueño o el admin pueden modificar
      allow create: if isAuth() && (request.auth.uid == request.resource.data.proId || isAdmin());
      allow update, delete: if isAuth() && (request.auth.uid == resource.data.proId || isAdmin());
    }

    // 5. NOTIFICACIONES (notificaciones)
    match /notificaciones/{notifId} {
      allow create: if true; // Permitir que la web pública envíe alertas/notificaciones al admin
      allow read, update, delete: if isAuth() && (request.auth.uid == resource.data.userId || request.auth.uid == 'admin' || isAdmin());
    }

    // 6. PAGOS (payments)
    match /payments/{paymentId} {
      allow create: if true; // Permitir que la web pública registre intenciones de pago/transferencias
      allow read, update, delete: if isAuth(); // Solo usuarios autenticados en la app pueden ver/validar pagos
    }

    // 6b. COMPRAS DE PLANES (plan_purchases)
    match /plan_purchases/{purchaseId} {
      allow create: if true; // Permitir que la web pública registre compras
      allow read, update, delete: if isAuth();
    }

    // 6c. SOLICITUDES DE EDICION DE PERFIL (profile_edit_requests)
    match /profile_edit_requests/{requestId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth();
    }

    // 6d. QUEJAS Y REPORTES (reports)
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth();
    }

    // 7. OTRAS COLECCIONES PUBLICAS TEMPORALES (comisiones, etc)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
